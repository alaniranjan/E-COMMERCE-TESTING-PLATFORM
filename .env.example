# ---- Application under test ----
TEST_ENV=qa
BASE_URL=https://www.saucedemo.com

# Password shared by all SauceDemo demo users (public, shown on the SauceDemo login page)
TEST_USER_PASSWORD=<sauce-demo-password>

# ---- Controlled test API (local mock, started automatically by Playwright) ----
API_BASE_URL=http://127.0.0.1:3001
API_USERNAME=api_user
API_PASSWORD=<local-test-api-password>
# Response-time budget for API assertions (ms)
API_RESPONSE_TIME_MS=1000

# ---- Browser ----
HEADLESS=true
# Timeouts in milliseconds
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# ---- AI (used from Phase 5) ----
AI_PROVIDER=ollama
AI_MODEL=<local-model-name>
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT=120000
# Test-case generation writes long output; on CPU this takes minutes
AI_GENERATION_TIMEOUT=600000
# Keep the model loaded between requests (Ollama duration format)
AI_KEEP_ALIVE=30m
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
# Longer prompts are truncated (middle removed) before sending to the model
AI_MAX_PROMPT_CHARS=12000
# Failure-analysis prompt version (failure-v1 | failure-v2)
AI_FAILURE_PROMPT=failure-v2
