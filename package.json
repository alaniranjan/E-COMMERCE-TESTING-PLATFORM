{
  "name": "ai-ecommerce-testing-platform",
  "version": "0.1.0",
  "description": "Playwright + TypeScript e-commerce test framework with AI-assisted failure analysis",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium --project=api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "dashboard:install": "npm --prefix dashboard install",
    "dashboard": "npm --prefix dashboard start",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "mock-api": "tsx mock-api/server.ts",
    "allure:generate": "node -e \"require('fs').rmSync('reports/allure',{recursive:true,force:true})\" && allure generate reports/allure-results -o reports/allure",
    "allure:open": "allure open reports/allure",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "ai:check": "tsx scripts/ai-check.ts",
    "test:ai": "playwright test --project=ai",
    "ai:benchmark": "tsx scripts/ai-benchmark.ts",
    "ai:generate": "tsx scripts/generate-test-cases.ts",
    "test:ai-demo": "tsx scripts/run-ai-demo.ts",
    "ai:analyze": "tsx scripts/analyze-failures.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "ai:bug-report": "tsx scripts/analyze-failures.ts --bug-reports"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.1",
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^1.0.0-beta.22",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "drizzle-orm": "^1.0.0-beta.22"
  }
}
